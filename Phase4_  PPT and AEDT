    # ---- project folder -> auto-detect Excel + CAD, derive NN_ number prefix
    _EXCEL_EXTS = (".xlsx", ".xlsm")
    _CAD_EXTS = (".stp", ".step", ".igs", ".iges", ".x_t", ".sat")

    @staticmethod
    def _num_prefix(name):
        """Leading number before the first underscore (e.g. '143_GC.stp' -> '143')."""
        if not name:
            return None
        m = re.match(r"\s*(\d+)_", os.path.basename(name))
        return m.group(1) if m else None

    def _pick_folder(self):
        d = filedialog.askdirectory(title="Project folder",
                                    initialdir=self.folder.get() or _HERE)
        if d:
            self.folder.delete(0, "end")
            self.folder.insert(0, d)
            self._scan_folder(d)

    def _scan_folder(self, folder):
        """Detect the Excel + CAD in `folder` by extension (not by exact name),
        read the NN_ number prefix from each, WARN (never block) on a missing or
        mismatched prefix, then fill the fields + default-name the outputs."""
        try:
            entries = sorted(os.listdir(folder))
        except Exception as e:  # noqa: BLE001
            messagebox.showerror("Folder", f"Cannot read folder:\n{e}")
            return

        def _pick(exts):
            cands = [f for f in entries
                     if f.lower().endswith(exts) and not f.startswith("~$")]
            if not cands:
                return None
            # prefer a name that already carries the NN_ prefix
            pref = [f for f in cands if re.match(r"\s*\d+_", f)]
            return (pref or cands)[0]

        excel = _pick(self._EXCEL_EXTS)
        cad = _pick(self._CAD_EXTS)
        warn = []
        if excel:
            self._set_excel(os.path.join(folder, excel))
        else:
            warn.append("No Excel (.xlsx/.xlsm) found in the folder.")
        if cad:
            self._set_cad(os.path.join(folder, cad))
        else:
            warn.append("No CAD (.stp/.step/.igs/.x_t/.sat) found in the folder.")

        n_xl = self._num_prefix(excel)
        n_cad = self._num_prefix(cad)
        if excel and n_xl is None:
            warn.append(f"Excel '{excel}' has no NN_ number prefix.")
        if cad and n_cad is None:
            warn.append(f"CAD '{cad}' has no NN_ number prefix.")
        if n_xl and n_cad and n_xl != n_cad:
            warn.append(f"Number prefix differs -> Excel={n_xl}, CAD={n_cad}. "
                        f"Using {n_xl}; edit it in 'Project number' if needed.")
        num = n_xl or n_cad or ""
        if num:
            self.projnum.delete(0, "end")
            self.projnum.insert(0, num)
        self._apply_prefix()

        self._append(f"[Folder] {folder}\n")
        if excel:
            self._append(f"  Excel : {excel}\n")
        if cad:
            self._append(f"  CAD   : {cad}\n")
        if num:
            self._append(f"  Number: {num}  (output prefix)\n")
        if warn:
            self._append("  ! " + "\n  ! ".join(warn) + "\n")
            messagebox.showwarning(
                "Folder scan",
                "\n".join(warn) + "\n\nYou can still proceed - edit any field manually.")

    def _apply_prefix(self):
        """Default-NAME the PPT / AEDT / Discovery outputs with the project
        number as a prefix (names only -- each saves into its own subfolder).
        Does nothing when the number is blank, so it never clobbers a manually
        typed name."""
        num = self.projnum.get().strip()
        if not num:
            return
        for ent, name in ((self.ppt, f"{num}_Thermal_Report.pptx"),
                          (self.aedt, f"{num}_AEDT.aedt"),
                          (self.disco_name, f"{num}_Discovery")):
            ent.delete(0, "end")
            ent.insert(0, name)

