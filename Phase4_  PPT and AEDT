    # ---- logging
    def _append(self, text):
        self.log.configure(state="normal")
        self.log.insert("end", text)
        self.log.see("end")
        self.log.configure(state="disabled")

    def _drain(self):
        try:
            while True:
                self._append(self.log_q.get_nowait())
        except queue.Empty:
            pass
        self.root.after(80, self._drain)

    # ---- run
    def _busy(self):
        return self.worker and self.worker.is_alive()

    def _start(self, mode):
        if self._busy():
            return
        cfg = self._cfg()
        if not os.path.isfile(cfg["excel"]):
            messagebox.showerror("Missing Excel", f"Excel not found:\n{cfg['excel']}")
            return
        if mode in ("ppt", "both"):
            tmpl = cfg.get("template") or ""
            if not os.path.isfile(tmpl):
                messagebox.showerror("Missing template",
                                     f"Report template (.pptx) not found:\n{tmpl}")
                return
        if mode in ("aedt", "both"):
            if not cfg["version"]:
                messagebox.showerror("Version", "Enter an AEDT version (e.g. 2025.2).")
                return
            if self.import_cad.get() and not os.path.isfile(cfg["cad"]):
                messagebox.showerror("Missing CAD", f"CAD not found:\n{cfg['cad']}")
                return
            aedt = cfg.get("aedt_path") or DEFAULT_AEDT
            if not aedt.lower().endswith(".aedt"):
                messagebox.showerror("AEDT project", "AEDT output name must end with .aedt")
                return
            folder = os.path.dirname(aedt) or _HERE
            try:
                os.makedirs(folder, exist_ok=True)   # AEDT subfolder, created on demand
            except Exception as e:  # noqa: BLE001
                messagebox.showerror("AEDT save folder", f"Cannot create save folder:\n{folder}\n{e}")
                return
        save_config(cfg)
        for b in (self.b_ppt, self.b_aedt, self.b_both):
            b.configure(state="disabled")
        self.log.configure(state="normal")
        self.log.delete("1.0", "end")
        self.log.configure(state="disabled")
        self.status.configure(text="Running ...")
        self.worker = threading.Thread(target=self._work, args=(mode, cfg), daemon=True)
        self.worker.start()

    def _do_ppt(self, cfg):
        print("=== CREATE PPT ===")
        mats, src = p1.load_materials(cfg["excel"])
        print(f"materials: {len(mats)} ({src})")
        out = cfg.get("ppt_path") or DEFAULT_PPT
        os.makedirs(os.path.dirname(out) or _HERE, exist_ok=True)   # PPT/ on demand
        # ALL Discovery snapshots (parts / current-path / overview) in ONE session
        images, cflow, cadimgs, surfaces = self._ppt_images(cfg, out)
        tmpl = cfg.get("template") or p1.DEFAULT_TEMPLATE
        print(f"[PPT] template: {tmpl}")
        p1.build_deck(mats, self.sim.get(), out, template=tmpl,
                      data_path=cfg["excel"], images=images,
                      collapse_parts=self.collapse_parts.get(),
                      drop_surfaces=self.drop_surfaces.get(),
                      current_flow_image=cflow, cad_images=cadimgs,
                      surface_names=surfaces)
        print(f"[PPT] saved -> {out}")

    def _ppt_images(self, cfg, out_ppt):
        """Produce all requested PPT snapshots + surface list in ONE Discovery
        session. Returns (part_images_dict, current_flow_png, [cad_overview_pngs],
        [surface_body_names]). Each is None/[] if its option is off or it fails."""
        want_parts = self.part_images.get()
        want_flow = self.current_flow.get()
        want_overview = self.sim_overview.get()
        want_surfaces = self.drop_surfaces.get()   # geometry-based surface detection
        if not (want_parts or want_flow or want_overview or want_surfaces):
            return None, None, None, None
        if not os.path.isfile(cfg["cad"]):
            print(f"[PPT] ! CAD not found ({cfg['cad']}) -> no images/surfaces")
            return None, None, None, None
        p41 = _load_phase41()
        if p41 is None:
            print("[PPT] ! could not load Phase4.1 -> no images/surfaces")
            return None, None, None, None

        groups = []
        if want_flow:
            yes = p1.read_conducting_parts(cfg["excel"])
            if yes:
                groups.append(("Current_Path", yes))
            else:
                print("[PPT] ! no 'Electrical Conducting = Yes' parts -> no current-flow image")
        imgdir = os.path.join(os.path.dirname(out_ppt) or _HERE, "Part_Images")
        print("[PPT] Discovery: all PPT images + surfaces in ONE session -> " + imgdir)
        try:
            res = p41.snapshot_session(
                cfg["cad"], imgdir, cfg["version"], print,
                part_views=["Isometric"] if want_parts else None,
                full_views=["Isometric", "Front"] if want_overview else None,
                groups=groups, hidden=False)
        except Exception as e:  # noqa: BLE001
            print(f"[PPT] ! image session failed: {e}")
            return None, None, None, None

        images = ({t: p for t, p in res.get("parts", [])} or None) if want_parts else None
        cflow = res.get("groups", {}).get("Current_Path") if want_flow else None
        cadimgs = ([p for _, p in res.get("full", [])] or None) if want_overview else None
        surfaces = res.get("surfaces", []) if want_surfaces else None
        if want_parts:
            print(f"[PPT] {len(images or {})} part image(s) ready")
        return images, cflow, cadimgs, surfaces

    def _do_aedt(self, cfg):
        print("\n=== SETUP AEDT ===")
        args = p2.build_parser().parse_args([])
        args.version = cfg["version"]
        args.excel = cfg["excel"]
        args.cad = cfg["cad"]
        args.project = cfg.get("aedt_path") or DEFAULT_AEDT   # AEDT/ subfolder + name
        os.makedirs(os.path.dirname(args.project) or _HERE, exist_ok=True)
        args.non_graphical = not self.show_gui.get()
        args.new_desktop = True
        args.no_import = not self.import_cad.get()
        args.use_discovery = self.use_discovery.get()    # live-link CAD via Discovery
        args.discovery_name = cfg.get("disco_name", "").strip()
        args.discovery_folder = cfg.get("discovery_folder", "")  # -> Discovery/ subfolder
        args.mesh_mode = self.mesh_mode.get()            # auto | manual (Excel Multi-Level)
        args.save = True
        args.close = True
        print(f"[Phase4] AEDT project will be saved as: {args.project}")
        print(f"[Phase4] Discovery (.dsco) folder: {args.discovery_folder}")
        print(f"[Phase4] mesh operation mode: {args.mesh_mode}")
        p2.run(args)

    def _work(self, mode, cfg):
        old_out, old_err = sys.stdout, sys.stderr
        buf, qw = [], _QueueWriter(self.log_q)

        class _Tee:
            def write(self, s):
                qw.write(s)
                buf.append(s)

            def flush(self):
                pass

        sys.stdout = sys.stderr = _Tee()
        ok = False
        try:
            if mode in ("ppt", "both"):
                self._do_ppt(cfg)
            if mode in ("aedt", "both"):
                self._do_aedt(cfg)
            ok = True
        except Exception:  # noqa: BLE001
            print("\n[Phase4] FAILED:\n" + traceback.format_exc())
        finally:
            sys.stdout, sys.stderr = old_out, old_err
            self._write_brief_log(buf)
            self.root.after(0, self._done, ok, mode)

    def _write_brief_log(self, buf):
        """Write a very short, high-signal run log to phase4_run.log (section
        headers + results/errors only) so it can be shared cheaply."""
        keep = []
        for ln in "".join(buf).splitlines():
            s, low = ln.strip(), ln.strip().lower()
            if s and (s.startswith(("===", "[Phase", "!")) or "error" in low
                      or "fail" in low or "skipped" in low or "reprioritized" in low
                      or "saved" in low or "done:" in low or "attempt" in low
                      or "has been created" in low or "priority set" in low
                      or low.startswith("block '") or "-> " in s):
                keep.append(s[:220])
        try:
            with open(os.path.join(_HERE, "phase4_run.log"), "w", encoding="utf-8") as fh:
                fh.write("\n".join(keep))
        except Exception:  # noqa: BLE001
            pass

    def _done(self, ok, mode):
        for b in (self.b_ppt, self.b_aedt, self.b_both):
            b.configure(state="normal")
        self.status.configure(text="Done" if ok else "Finished with errors")
        if ok:
            msg = {"ppt": "PPT created.", "aedt": "AEDT set up, saved & closed.",
                   "both": "PPT created, then AEDT set up, saved & closed."}[mode]
            messagebox.showinfo("Phase 3", msg)
        else:
            messagebox.showwarning("Phase 3", "Finished with errors. See the log.")

    def _on_close(self):
        save_config(self._cfg())
        self.root.destroy()


def main():
    root = tk.Tk()
    Phase4GUI(root)
    root.mainloop()


if __name__ == "__main__":
    main()
