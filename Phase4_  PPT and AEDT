def _load_embedded(_name):
    """exec a bundled module into its own namespace (cached in sys.modules)."""
    _m = sys.modules.get(_name)
    if _m is not None and getattr(_m, "__embedded__", False):
        return _m
    _src = _b64.b64decode(_EMBEDDED_SRC[_name]).decode("utf-8")
    _mod = _types.ModuleType(_name)
    _mod.__file__ = os.path.join(_HERE, _name + ".py")
    _mod.__embedded__ = True
    sys.modules[_name] = _mod
    exec(compile(_src, _mod.__file__, "exec"), _mod.__dict__)
    return _mod


