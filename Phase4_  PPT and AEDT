    # ---- output routing: PPT / AEDT / Discovery each save into their own
    #      subfolder under the project folder, created on demand.
    _OUT_SUBDIRS = {"ppt": "PPT", "aedt": "AEDT", "discovery": "Discovery"}

    def _base_dir(self):
        """Folder the output subfolders live under: the project folder if set,
        else the Excel's folder, else this script's folder."""
        folder = self.folder.get().strip()
        if folder and os.path.isdir(folder):
            return folder
        xl = self.excel_path
        if xl and os.path.dirname(xl):
            return os.path.dirname(xl)
        return _HERE

    def _sub_dir(self, kind):
        return os.path.join(self._base_dir(), self._OUT_SUBDIRS[kind.lower()])

    def _out_path(self, kind):
        """Full save path for 'ppt' or 'aedt' = name box (ext enforced) inside
        that kind's subfolder."""
        k = kind.lower()
        if k == "ppt":
            ent, ext, default = self.ppt, ".pptx", "Thermal_Report.pptx"
        else:
            ent, ext, default = self.aedt, ".aedt", "AEDT.aedt"
        name = ent.get().strip() or default
        if not name.lower().endswith(ext):
            name += ext
        return os.path.join(self._sub_dir(k), name)

    def _open_dir(self, kind):
        """Open the kind's output subfolder in the file browser (create first)."""
        d = self._sub_dir(kind)
        try:
            os.makedirs(d, exist_ok=True)
        except Exception as e:  # noqa: BLE001
            messagebox.showerror("Open folder", f"Cannot create folder:\n{d}\n{e}")
            return
        try:
            os.startfile(d)  # Windows
        except Exception:  # noqa: BLE001
            try:
                import subprocess
                subprocess.Popen(["explorer", os.path.normpath(d)])
            except Exception as e:  # noqa: BLE001
                messagebox.showerror("Open folder", str(e))

