def _load_phase41():
    """Return the BUNDLED Phase 4.1 module (cached), or None on failure."""
    global _phase41_mod
    if _phase41_mod is not None:
        return _phase41_mod
    try:
        _phase41_mod = _load_embedded("phase41")
        return _phase41_mod
    except Exception:  # noqa: BLE001
        return None


def load_config():
    try:
        with open(CONFIG_PATH, encoding="utf-8") as fh:
            return json.load(fh)
    except Exception:  # noqa: BLE001
        return {}


def save_config(cfg):
    try:
        with open(CONFIG_PATH, "w", encoding="utf-8") as fh:
            json.dump(cfg, fh, indent=2)
    except Exception:  # noqa: BLE001
        pass


class _QueueWriter:
    def __init__(self, q):
        self.q = q

    def write(self, s):
        if s:
            self.q.put(s)

    def flush(self):
        pass


class Phase4GUI:
    def __init__(self, root):
        self.root = root
        self.cfg = load_config()
        self.log_q: queue.Queue = queue.Queue()
        self.worker: threading.Thread | None = None

        root.title("Phase 4  -  Thermal Report + AEDT Setup")
        root.configure(bg=BG)
        root.minsize(780, 795)

        self._style()
        self._header()
        self._form()
        self._actions()
        self._logbox()

        self._load_fields()
        root.protocol("WM_DELETE_WINDOW", self._on_close)
        self.root.after(80, self._drain)

    # ---- style / layout
    def _style(self):
        st = ttk.Style()
        try:
            st.theme_use("clam")
        except Exception:  # noqa: BLE001
            pass
        st.configure("TFrame", background=BG)
        st.configure("TLabel", background=CARD, foreground=INK, font=("Segoe UI", 10))
        st.configure("Head.TLabel", background=BG, foreground=INK, font=("Segoe UI Semibold", 17))
        st.configure("Sub.TLabel", background=BG, foreground=MUTE, font=("Segoe UI", 9))
        st.configure("Field.TLabel", background=CARD, foreground=MUTE, font=("Segoe UI", 9))
        st.configure("TCheckbutton", background=CARD, foreground=INK, font=("Segoe UI", 10))
        st.configure("TRadiobutton", background=CARD, foreground=INK, font=("Segoe UI", 10))
        st.configure("Run.TButton", font=("Segoe UI Semibold", 11), foreground="#ffffff",
                     background=ACCENT, borderwidth=0, padding=(16, 9))
        st.map("Run.TButton", background=[("active", "#9e0000"), ("disabled", "#d9a3a3")])
        st.configure("Sec.TButton", font=("Segoe UI", 10), padding=(12, 7))
        st.configure("TButton", font=("Segoe UI", 9), padding=(10, 5))

    def _header(self):
        top = tk.Frame(self.root, bg=BG)
        top.pack(fill="x", padx=20, pady=(16, 6))
        ttk.Label(top, text="Phase 4  -  Report + AEDT", style="Head.TLabel").pack(anchor="w")
        ttk.Label(top, text="Create the PowerPoint report, then set up the Icepak model "
                            "from one shared Excel.", style="Sub.TLabel").pack(anchor="w", pady=(2, 0))
        tk.Frame(self.root, bg=ACCENT, height=3).pack(fill="x", padx=20)

    def _card(self):
        outer = tk.Frame(self.root, bg=BG)
        outer.pack(fill="x", padx=20, pady=(12, 0))
        card = tk.Frame(outer, bg=CARD, highlightbackground="#e5e7eb", highlightthickness=1)
        card.pack(fill="x")
        return card

    def _form(self):
        card = self._card()
        card.columnconfigure(1, weight=1)
        pad = dict(padx=14, pady=7)

        # auto-detected inputs are shown NAME-only + read-only; the full path is
        # kept in these attrs and only changed via the 'Change...' picker.
        self.excel_path = ""
        self.cad_path = ""
        self.excel_var = tk.StringVar()
        self.cad_var = tk.StringVar()

        # PROJECT FOLDER -> auto-detect Excel + CAD, derive the NN_ number prefix
        self.folder = self._file_row(card, 0, "PROJECT FOLDER", self._pick_folder)

        # detected project number (editable) -> default prefix for all outputs
        numrow = tk.Frame(card, bg=CARD)
        numrow.grid(row=1, column=0, columnspan=2, sticky="w", padx=10, pady=(0, 6))
        ttk.Label(numrow, text="Project number (output prefix):",
                  style="Field.TLabel").pack(side="left", padx=(4, 6))
        self.projnum = ttk.Entry(numrow, font=("Segoe UI", 10), width=16)
        self.projnum.pack(side="left")
        ttk.Button(numrow, text="Apply to outputs",
                   command=self._apply_prefix).pack(side="left", padx=(8, 0))
        self.projnum.bind("<Return>", lambda _e: self._apply_prefix())

        ttk.Label(card, text="AEDT VERSION", style="Field.TLabel").grid(row=2, column=0, sticky="w", **pad)
        self.version = ttk.Combobox(card, values=KNOWN_VERSIONS, state="normal",
                                    font=("Segoe UI", 10), width=14)
        self.version.grid(row=2, column=1, sticky="w", **pad)

        self.excel = self._in_row(card, 3, "MATERIAL EXCEL", "excel")
        self.cad = self._in_row(card, 4, "CAD (STEP) FILE", "cad")

        # OUTPUTS: edit the file NAME only; each is saved into its own subfolder
        # (PPT/ AEDT/ Discovery/) under the project folder. 'Open folder' shows it.
        self.ppt = self._out_row(card, 5, "PPT OUTPUT (name)", "PPT")
        self.aedt = self._out_row(card, 6, "AEDT OUTPUT (name)", "AEDT")
        self.disco_name = self._out_row(card, 7, "DISCOVERY OUTPUT (name)", "Discovery")

        # Report template (.pptx) for the PPT report -- user-selectable and
        # remembered between runs (defaults to the template beside this app).
        self.template = self._file_row(card, 8, "REPORT TEMPLATE (PPT)", self._pick_template)

