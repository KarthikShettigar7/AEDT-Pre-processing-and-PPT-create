# Phase 4.1 lives in the sibling 'Phase4.1' folder and its file name has a dot,
# so it can't be a normal import -- load it by path when part images are needed.
_PHASE41_PATH = os.path.join(os.path.dirname(_HERE), "Phase4.1", "Phase4.1.py")
_phase41_mod = None


def _load_phase41():
    """Load Phase4.1.py by path (cached). Returns the module or None."""
    global _phase41_mod
    if _phase41_mod is not None:
        return _phase41_mod
    try:
        import importlib.util
        spec = importlib.util.spec_from_file_location("phase41", _PHASE41_PATH)
        mod = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(mod)
        _phase41_mod = mod
        return mod
    except Exception:  # noqa: BLE001
        return None


def load_config():
    try:
        with open(CONFIG_PATH, encoding="utf-8") as fh:
            return json.load(fh)
    except Exception:  # noqa: BLE001
        return {}


def save_config(cfg):
    try:
        with open(CONFIG_PATH, "w", encoding="utf-8") as fh:
            json.dump(cfg, fh, indent=2)
    except Exception:  # noqa: BLE001
        pass


class _QueueWriter:
    def __init__(self, q):
        self.q = q

    def write(self, s):
        if s:
            self.q.put(s)

    def flush(self):
        pass


class Phase4GUI:
