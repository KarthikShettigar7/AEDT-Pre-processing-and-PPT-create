def load_parametric_table(aedt, csvf, use_csv):
    global oProject

    if oProject is None:
        oProject = Icepak(
            project=aedt,
            version="2025.2",
            non_graphical=False,
            new_desktop=True,
            close_on_exit=False,
            remove_lock=True
        )

    if use_csv:
        df = pd.read_csv(csvf)
    else:
        tmp = tempfile.NamedTemporaryFile(suffix=".csv", delete=False)
        tmp.close()
        SetupParam(oProject, "ParametricSetup1").export_to_csv(tmp.name)
        df = pd.read_csv(tmp.name)
        os.remove(tmp.name)

    df = df.drop(columns=[c for c in df.columns if c.strip() == "*"], errors="ignore")
    df.index += 1
    return df

def build_filename(row_idx, row, orientation, quantity):
    parts = [str(row_idx)]
    for k, v in row.items():
        if pd.notna(v):
            parts.extend([str(k), str(v)])
    parts.append(orientation)
    parts.append(quantity)
    return "_".join(parts) + ".jpg"

INVALID_PATH_CHARS = '<>:"/\\|?*'

def sanitize_path_part(text, max_len=60):
    s = str(text)
    for ch in INVALID_PATH_CHARS:
        s = s.replace(ch, "_")
    s = re.sub(r"\s+", "_", s).strip("._ ")
    return s[:max_len] if s else "unnamed"

def build_variation_dir(row_idx, row):
    parts = ["Design_" + str(row_idx)]
    for k, v in row.items():
        if pd.notna(v):
            parts.extend([sanitize_path_part(k, 24), sanitize_path_part(v, 24)])
    return sanitize_path_part("_".join(parts), 110)

def build_export_dir(base_dir, design_name, row_idx, row):
    return os.path.join(
        base_dir,
        sanitize_path_part(design_name, 50),
        build_variation_dir(row_idx, row)
    )

def build_preview(df):
    for w in table.winfo_children():
        w.destroy()
    preview_rows.clear()

    post = oProject.post
    plots = []
    for name, fp in post.field_plots.items():
        plots.append({
            "plot": name,
            "folder": fp.plot_folder,
            "quantity": fp.quantity,
            "surfaces": list(getattr(fp, "surfaces", []))
        })

    plots_df = pd.DataFrame(plots)
    plots_df["quantity"] = (
        plots_df["quantity"]
        + (plots_df.groupby("quantity").cumcount() + 1).astype(str)
    )

    orientations = [o.strip() for o in orientation_var.get().split(",") if o.strip()]
    if not orientations:
        orientations = ["isometric"]

    design_name = oProject.design_name

    for idx, row in df.iterrows():
        subfolder = os.path.join(
            sanitize_path_part(design_name, 50),
            build_variation_dir(idx, row)
        )

        ctk.CTkLabel(
            table,
            text="\\" + subfolder + "\\",
            font=("Sitka Small", 12, "bold"),
            text_color=LIGHT_GREEN,
            anchor="w"
        ).pack(anchor="w", padx=10, pady=(10, 2))

        for orient in orientations:
            for _, p in plots_df.iterrows():
                fname = build_filename(idx, row, orient, p["quantity"])
                var = ctk.BooleanVar(value=True)

                chk = ctk.CTkCheckBox(
                    table,
                    text=fname,
                    variable=var,
                    font=("Sitka Small", 11),
                    text_color=WHITE,
                    fg_color=LIGHT_GREEN,
                    checkmark_color="black",
                    hover_color=LIGHT_GREEN
                )
                chk.pack(anchor="w", padx=30, pady=2)

                preview_rows.append((var, idx, row, orient, p, design_name))

def map_surfaces_to_objects(surface_ids):
    surface_ids = set(int(s) for s in surface_ids)
    objs = []
    for name in oProject.modeler.object_names:
        try:
            obj = oProject.modeler.get_object_from_name(name)
            if int(obj.id) in surface_ids:
                objs.append(name)
        except:
            pass
    return list(dict.fromkeys(objs))

