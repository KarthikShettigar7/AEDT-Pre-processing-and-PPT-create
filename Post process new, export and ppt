def _json_safe(v):
    try:
        if v is None or pd.isna(v):
            return None
    except (TypeError, ValueError):
        pass
    if hasattr(v, "item"):
        try:
            return v.item()
        except (AttributeError, ValueError):
            pass
    if isinstance(v, (bool, int, float, str)):
        return v
    return str(v)

def _sort_key(rec):
    return (str(rec.get("design", "")), _json_safe(rec.get("row")) or 0,
            rec.get("seq", 0))

def write_manifest(base_dir, new_recs):
    """Describe every exported image so the PPT step knows which design point,
    variables, orientation and quantity each file belongs to. Entries survive
    across runs (so a stopped-then-resumed export still builds a full report);
    rows whose file has been deleted are dropped."""
    path = os.path.join(base_dir, MANIFEST_NAME)
    keep = {}
    if os.path.isfile(path):
        try:
            with open(path, encoding="utf-8") as fh:
                for rec in json.load(fh).get("images", []):
                    rel = rec.get("path", "")
                    if rel and os.path.isfile(os.path.join(base_dir, rel)):
                        keep[rel] = rec
        except Exception:
            print("[Export] ! could not read the existing manifest, rewriting it")
    for rec in new_recs:
        keep[rec["path"]] = rec

    with open(path, "w", encoding="utf-8") as fh:
        json.dump({"version": 1, "images": sorted(keep.values(), key=_sort_key)},
                  fh, indent=2)
    return path

# ---------------------------------------------------------------- status / busy
def _busy():
    return worker is not None and worker.is_alive()

def _set_status(text):
    """Safe from any thread - the main thread applies it in _pump_ui()."""
    ui_queue.put(("status", str(text)[:110]))

def _log(text):
    print(text)
    _set_status(text)

def _fmt_hms(seconds):
    seconds = int(max(0, seconds))
    return f"{seconds // 3600:02d}:{(seconds % 3600) // 60:02d}:{seconds % 60:02d}"

def _refresh_progress(final=None):
    """Redraw the counter / elapsed clock. Main thread only.

    Called from _pump_ui on every tick, so the clock keeps ticking while AEDT
    renders and the counter moves as soon as the worker reports an image.
    """
    done, total = export_state["done"], export_state["total"]
    t0 = export_state["t0"]
    elapsed = (time.time() - t0) if t0 else 0

    progress_bar.set((done / total) if total else 0)

    if final:
        progress_var.set(f"{final}:  {done} / {total} exported   |   "
                         f"total time {_fmt_hms(elapsed)}")
        return
    if not export_state["running"]:
        progress_var.set("")
        return

    parts = [f"{done} / {total} exported", f"elapsed {_fmt_hms(elapsed)}"]
    if done:
        per = elapsed / done
        parts.append(f"avg {per:.0f}s / image")
        parts.append(f"ETA {_fmt_hms(per * (total - done))}")
    progress_var.set("   |   ".join(parts))

def _pump_ui():
    """Main-thread pump: apply whatever the worker thread posted. It must always
    re-arm itself -- if it ever died, every later status update would be lost."""
    try:
        while True:
            try:
                kind, payload = ui_queue.get_nowait()
            except queue.Empty:
                break
            try:
                if kind == "status":
                    status_var.set(payload)
                elif kind == "progress":
                    export_state["done"] = payload
                elif kind == "export_done":
                    _export_done(*payload)
                elif kind == "ppt_done":
                    _ppt_done(*payload)
            except Exception:
                print(traceback.format_exc())
        if export_state["running"]:
            _refresh_progress()
    finally:
        app.after(120, _pump_ui)

def _set_running(running, allow_stop=True):
    state = "disabled" if running else "normal"
    for b in (btn_load, btn_select, btn_unselect, btn_export, btn_ppt):
        b.configure(state=state)
    btn_stop.configure(state="normal" if (running and allow_stop) else "disabled")

# --------------------------------------------------------------------- export
def export_selected():
    """Start the export in a worker thread so the GUI (and the STOP button)
    stays responsive while AEDT renders."""
    global worker
    if _busy():
        return
    if oProject is None:
        messagebox.showerror("Error", "AEDT is not open. Press LOAD DATA first.")
        return
    if not preview_rows:
        messagebox.showerror("Error", "Nothing to export. Press LOAD DATA first.")
        return

    base_dir = exports_root()
    if not base_dir:
        messagebox.showerror("Error", "Select the AEDT file first.")
        return

    # read the checkbox vars HERE (tk vars belong to the main thread)
    jobs = [(seq, idx, row, orient, plot, design)
            for seq, (var, idx, row, orient, plot, design) in enumerate(preview_rows)
            if var.get()]
    if not jobs:
        messagebox.showerror("Error", "No images selected.")
        return

    hide_logo = True          # always strip the "Ansys <version>" stamp
    if Image is None:
        messagebox.showwarning("Pillow missing",
                              "Pillow is not installed, so the Ansys stamp cannot "
                              "be removed.\nThe images will keep it.\n\n"
                              "Install it with:  pip install pillow")
        hide_logo = False

    os.makedirs(base_dir, exist_ok=True)
    stop_event.clear()
    export_state.update(done=0, total=len(jobs), t0=time.time(), running=True)
    _refresh_progress()
    _set_running(True)
    worker = threading.Thread(target=_export_worker, args=(jobs, base_dir, hide_logo),
                              daemon=True)
    worker.start()

def _export_worker(jobs, base_dir, hide_logo=False):
    post = oProject.post
    recs, done, stopped, err, released = [], 0, False, None, False
    total = len(jobs)

    try:
        for n, (seq, idx, row, orient, plot, design_name) in enumerate(jobs, 1):
            # the stop flag is checked BETWEEN images, so AEDT is never
            # interrupted half-way through writing a JPG
            if stop_event.is_set():
                stopped = True
                break

            _log(f"[Export] {n}/{total}  case {idx}  {orient}  {plot['quantity']}")

            for param_name, param_value in row.items():
                if pd.notna(param_value):
                    oProject[param_name] = param_value

            post.plot_field_from_fieldplot(plot["plot"], show=False)
            objs = map_surfaces_to_objects(plot["surfaces"])

            out_dir = build_export_dir(base_dir, design_name, idx, row)
            os.makedirs(out_dir, exist_ok=True)
            fname = build_filename(idx, row, orient, plot["quantity"])
            full = os.path.join(out_dir, fname)

# Resolution: 4K UHD  & Size (px): 3840 × 2160
            post.export_field_jpg(
                full,
                plot["plot"],
                plot["folder"],
                orientation=orient,
                width=3840,
                height=2160,
                selections=objs,
                show_axis=False,
                show_grid=False,
                show_ruler=False,
                show_region=False
            )

            if hide_logo:
                try:
                    if not strip_logo(full):
                        print(f"[Export] ! no Ansys stamp found to remove in {fname}")
                except Exception:
                    print(traceback.format_exc())

            recs.append({
                "path": os.path.relpath(full, base_dir),
                "design": str(design_name),
                "row": _json_safe(idx),
                "params": {str(k): _json_safe(v) for k, v in row.items()
                           if pd.notna(v)},
                "orientation": orient,
                "quantity": str(plot["quantity"]),
                "plot": str(plot["plot"]),
                "seq": seq,
            })
            done += 1
            ui_queue.put(("progress", done))
    except Exception:
        err = traceback.format_exc()
        print(err)

    if recs:
        try:
            write_manifest(base_dir, recs)
        except Exception:
            print(traceback.format_exc())

    if stopped:
        _log("[Export] stop requested -> closing AEDT ...")
        try:
            oProject.release_desktop()
            released = True
        except Exception:
            print(traceback.format_exc())

    ui_queue.put(("export_done", (done, total, stopped, err, released, base_dir)))

def _export_done(done, total, stopped, err, released, base_dir):
    global oProject
    export_state["done"] = done
    export_state["running"] = False
    _refresh_progress(final="Failed" if err else ("Stopped" if stopped else "Complete"))
    elapsed = _fmt_hms(time.time() - export_state["t0"]) if export_state["t0"] else "-"

    if released:
        oProject = None
        for wdg in table.winfo_children():
            wdg.destroy()
        preview_rows.clear()

    _set_running(False)
    if released:
        btn_export.configure(state="disabled")

    if err:
        _set_status(f"Failed after {done}/{total} - {elapsed}")
        messagebox.showerror("Export failed",
                             f"Exported {done} of {total} in {elapsed} before the error."
                             f"\n\n{err.strip().splitlines()[-1]}")
    elif stopped:
        _set_status(f"Stopped at {done}/{total} after {elapsed} - AEDT closed")
        messagebox.showinfo("Stopped",
                            f"Export stopped safely after {done} of {total} image(s).\n"
                            f"Time elapsed: {elapsed}\n"
                            f"AEDT has been closed.\n\n{base_dir}")
    else:
        _set_status(f"Export complete - {done} image(s) in {elapsed}")
        messagebox.showinfo("Done",
                            f"Export complete: {done} image(s)\n"
                            f"Time elapsed: {elapsed}\n\n{base_dir}")

# ------------------------------------------------------------- stop / close
def stop_and_close():
    """Stop the export loop between two images, then close AEDT cleanly.
    With no export running it just closes AEDT."""
    if _busy():
        stop_event.set()
        btn_stop.configure(state="disabled")
        _set_status("Stop requested - finishing the current image, then closing AEDT ...")
        return
    if oProject is None:
        messagebox.showinfo("AEDT", "AEDT is not open.")
        return
    if not messagebox.askyesno("Close AEDT",
                               "No export is running.\nClose the AEDT session now?"):
        return
    close_aedt()

def close_aedt():
    global oProject
    if oProject is None:
        return
    _set_status("Closing AEDT ...")
    try:
        oProject.release_desktop()
    except Exception:
        print(traceback.format_exc())
    oProject = None
    for wdg in table.winfo_children():
        wdg.destroy()
    preview_rows.clear()
    btn_export.configure(state="disabled")
    _set_status("AEDT closed")

# ------------------------------------------------------------------ PPT step
def load_images_to_ppt():
    """Fill the Results section of the report template with the exported
    images - two images per slide."""
    global worker
    if _busy():
        return
    if ppt_core is None:
        messagebox.showerror("PPT unavailable",
                             "Could not load ppt_report_core.py.\n\n"
                             f"{_PPT_IMPORT_ERROR}\n\n"
                             "Install python-pptx:  pip install python-pptx")
        return

    template = ppt_entry.get().strip()
    if not os.path.isfile(template):
        messagebox.showerror("Error", "Select the report template (.pptx) first.")
        return
    try:
        with open(template, "rb"):
            pass
    except OSError:
        messagebox.showerror("Template locked",
                             "The template cannot be read - it is open in "
                             "PowerPoint.\nClose it and try again:\n\n" + template)
        return

    base_dir = exports_root()
    if not base_dir or not os.path.isfile(os.path.join(base_dir, MANIFEST_NAME)):
        picked = filedialog.askdirectory(
            title="Select the Exports folder (the one holding " + MANIFEST_NAME + ")")
        if not picked:
            return
        base_dir = picked

    manifest = os.path.join(base_dir, MANIFEST_NAME)
    if not os.path.isfile(manifest):
        messagebox.showerror("No exported images",
                             f"{MANIFEST_NAME} not found in:\n{base_dir}\n\n"
                             "Export the images first.")
        return
    try:
        with open(manifest, encoding="utf-8") as fh:
            recs = json.load(fh).get("images", [])
    except Exception as e:
        messagebox.showerror("Manifest unreadable", str(e))
        return
    if not recs:
        messagebox.showerror("No exported images", f"{manifest} is empty.")
        return

    out = filedialog.asksaveasfilename(
        title="Save the report as",
        defaultextension=".pptx",
        initialfile="Results_Report.pptx",
        initialdir=os.path.dirname(base_dir) or _HERE,
        filetypes=[("PowerPoint", "*.pptx")]
    )
    if not out:
        return
    if os.path.abspath(out) == os.path.abspath(template):
        messagebox.showerror("Error", "Choose an output file different from the template.")
        return

    _set_running(True, allow_stop=False)
    worker = threading.Thread(target=_ppt_worker, args=(template, out, recs, base_dir),
                              daemon=True)
    worker.start()

def _ppt_worker(template, out, recs, base_dir):
    err, slides, imgs = None, 0, 0
    try:
        _log(f"[PPT] building from {len(recs)} exported image(s) ...")
        slides, imgs = ppt_core.build_results_deck(template, out, recs, base_dir, log=_log)
    except Exception:
        err = traceback.format_exc()
        print(err)
    ui_queue.put(("ppt_done", (slides, imgs, out, err)))

def _ppt_done(slides, imgs, out, err):
    _set_running(False)
    if oProject is None:
        btn_export.configure(state="disabled")
    if err:
        _set_status("PPT build failed")
        messagebox.showerror("PPT failed", err.strip().splitlines()[-1])
        return
    _set_status(f"PPT ready - {slides} results slide(s)")
    if messagebox.askyesno("PPT ready",
                           f"{slides} results slide(s), {imgs} image(s):\n{out}\n\n"
                           "Open it now?"):
        try:
            os.startfile(out)
        except Exception:
            print(traceback.format_exc())

