def strip_logo(path, box=LOGO_BOX):
    """Erase the "Ansys 2025 R2" stamp from an exported image.

    Only pixels that are near-neutral (grey/black text) AND clearly different
    from the surrounding background are replaced, so a coloured model that
    reaches into the top-right corner is left alone. The background colour is
    sampled from the box border rather than assumed white.
    """
    if Image is None:
        return False
    with Image.open(path) as src:
        im = src.convert("RGB")
    w, h = im.size
    left, top = int(w * box[0]), int(h * box[1])
    right, bottom = int(w * box[2]), int(h * box[3])
    if right <= left or bottom <= top:
        return False

    crop = im.crop((left, top, right, bottom))
    cw, ch = crop.size
    px = crop.load()

    # background = most common colour along the box border
    border = [px[x, 0] for x in range(cw)] + [px[cw - 1, y] for y in range(ch)]
    bg = max(set(border), key=border.count)

    cleared = 0
    for y in range(ch):
        for x in range(cw):
            r, g, b = px[x, y]
            # the threshold has to be low: the stamp is antialiased, and JPEG
            # leaves faint ringing around it that is still visible on white
            neutral = max(r, g, b) - min(r, g, b) <= 40          # grey/black text
            differs = (abs(r - bg[0]) + abs(g - bg[1]) + abs(b - bg[2])) > 9
            if neutral and differs:
                px[x, y] = bg
                cleared += 1
    if not cleared:
        return False

    im.paste(crop, (left, top))
    im.save(path, quality=95)
    return True

def exports_root():
